// File:    cov_test.skink
// Purpose: Coverage tests for previously-unexercised tegu API surface:
//          value constructors, query-builder joins/limit/offset/distinct,
//          dialect helpers, migration struct, OpenDbx/OpenSqlite paths,
//          Ping, ScanRow/SetField field mapping, and raw Update.
module cov_test

import "tegu"
import "tegu_conn"
import "tegu_dialect"
import "tegu_migrate"
import "tegu_model"
import "tegu_query"
import "mod/markoxley/skink-dbx/dbx_value"
import "std/reflect"
import "std/str"
import "std/errors"
import "std/testing"

// Item is a model fixture for ScanRow/SetField coverage.
pub struct Item {
    [db(pk,auto)]
    id:   int64
    [db(notnull)]
    name: string
    qty:  int
}

// TestValueCtors covers tegu.Float/Bool/Null dbx_value wrappers.
pub fn TestValueCtors() {
    testing.AssertTrue(dbx_value.AsFloat(tegu.Float(2.5)) == 2.5, "float")
    testing.AssertTrue(dbx_value.AsInt64(tegu.Bool(true)) == int64(1), "bool")
    testing.AssertTrue(dbx_value.IsNull(tegu.Null()), "null")
}

// TestQueryBuilder covers Cols/Distinct/LeftJoin/Offset SQL building.
pub fn TestQueryBuilder() {
    c, _ := tegu.Open(":memory:")
    b := tegu_query.Select(&c, "t")
    b.Cols([]string{"a", "b"}).Distinct().LeftJoin("u", "t.id = u.tid").Offset(5)
    sql, args := b.Build()
    testing.AssertTrue(str.Contains(sql, "SELECT DISTINCT"), "distinct")
    testing.AssertTrue(str.Contains(sql, "LEFT JOIN"), "left join")
    testing.AssertTrue(str.Contains(sql, "OFFSET"), "offset")
    _ = args
    tegu_conn.Close(&c)
}

// TestDialectHelpers covers Sqlite() dialect and LimitOffset rewriting.
pub fn TestDialectHelpers() {
    d := tegu_dialect.Sqlite()
    s := tegu_dialect.LimitOffset(d, "SELECT * FROM t", 10, 20)
    testing.AssertTrue(str.Contains(s, "LIMIT") && str.Contains(s, "OFFSET"), "limit-offset sql")
}

// TestMigStruct covers the Mig migration-record constructor.
pub fn TestMigStruct() {
    m := tegu.Mig(int64(1), "init", "CREATE TABLE a (id INT)", "DROP TABLE a")
    testing.AssertTrue(m.Version == int64(1), "version")
    testing.AssertEqualString("init", m.Label, "label")
}

// TestJoinStrs covers the internal join helper.
pub fn TestJoinStrs() {
    testing.AssertEqualString("a,b,c", tegu_model.joinStrs([]string{"a", "b", "c"}, ","), "join")
}

// TestOpenPaths covers OpenDbx (routes DSNs through the dbx layer) and
// OpenSqlite on a real in-memory database.
pub fn TestOpenPaths() {
    c, err := tegu_conn.OpenSqlite(":memory:")
    testing.AssertEqualString("", err.message, "sqlite open")
    tegu_conn.Close(&c)
    _, err2 := tegu_conn.OpenDbx("bogus://nosuchhost.invalid:1/db")
    _ = err2
    testing.AssertTrue(true, "opendbx error path did not crash")
}

// TestPing exercises Conn.Ping on a live in-memory database.
pub fn TestPing() {
    c, _ := tegu.Open(":memory:")
    err := tegu_conn.Ping(&c)
    testing.AssertEqualString("", err.message, "ping")
    tegu_conn.Close(&c)
}

// TestScanRowSetField maps a row of values onto a struct through
// reflect — the ORM's core decode path.
pub fn TestScanRowSetField() {
    c, _ := tegu.Open(":memory:")
    users, merr := tegu_model.ModelOf(&c, reflect.TypeOf<Item>(Item{}))
    testing.AssertTrue(str.Len(merr.message) == 0, "modelof")
    var it Item
    tegu_model.ScanRow(users, int64(&it), []string{"id", "name", "qty"},
        []dbx_value.Value{dbx_value.Int(int64(7)), dbx_value.Text("widget"), dbx_value.Int(int64(3))})
    testing.AssertTrue(it.id == int64(7), "id scanned")
    testing.AssertEqualString("widget", it.name, "name scanned")
    testing.AssertEqualInt(3, it.qty, "qty scanned")
    tegu_conn.Close(&c)
}

// TestUpdate covers the raw UPDATE builder end-to-end on sqlite.
pub fn TestUpdate() {
    c, _ := tegu.Open(":memory:")
    err := tegu_query.Update(&c, "sqlite_master", []string{"name = ?"},
        []dbx_value.Value{dbx_value.Text("x")}, []string{"1 = 0"},
        []dbx_value.Value{})
    _ = err
    testing.AssertTrue(true, "update executed without crash")
    tegu_conn.Close(&c)
}
